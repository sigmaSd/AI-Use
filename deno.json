{
  "name": "aiuse",
  "version": "0.2.0",
  "license": "MIT",
  "exports": "./report.ts",
  "tasks": {
    "compile": "deno desktop --allow-net --allow-env --output ./dist/aiuse report.ts",
    "package:rpm": "deno desktop --allow-net --allow-env --output ./dist/aiuse.rpm report.ts"
  },
  "desktop": {
    "app": {
      "name": "AI Usage",
      "identifier": "io.github.sigmasd.aiuse",
      "icons": {
        "linux": "./assets/icon.png"
      }
    },
    "backend": "webview",
    "output": {
      "linux": "./dist/aiuse.rpm"
    }
  }
}
