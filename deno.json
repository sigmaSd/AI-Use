{
  "name": "aiuse",
  "version": "0.4.0",
  "license": "MIT",
  "exports": "./src/main.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@sigmasd/denoapk/handler": "jsr:@sigmasd/denoapk@0.5.1/handler",
    "qrcode-generator": "npm:qrcode-generator@^2.0.4"
  },
  "exclude": [
    ".flatpak-builder",
    "build",
    "dist",
    "src/web/dist"
  ],
  "tasks": {
    "bundle": "deno bundle --platform browser src/web/main.ts -o src/web/dist/app.js",
    "test": "deno test --allow-net --allow-read --allow-sys src/",
    "dev": {
      "command": "deno run --allow-net --allow-read --allow-sys src/main.ts",
      "dependencies": ["bundle"]
    },
    "dev:android": {
      "command": "deno run -A scripts/dev-android.ts",
      "dependencies": ["bundle"]
    },
    "compile": "deno task bundle && deno desktop --allow-net --allow-read --allow-sys --exclude-unused-npm --include ./src/web/index.html --include ./src/web/dist --output ./dist/aiuse src/main.ts",
    "package:rpm": "deno task bundle && deno desktop --allow-net --allow-read --allow-sys --exclude-unused-npm --include ./src/web/index.html --include ./src/web/dist --output ./dist/aiuse.rpm src/main.ts"
  },
  "desktop": {
    "app": {
      "name": "AI Usage",
      "identifier": "io.github.sigmasd.aiuse",
      "icons": {
        "linux": "./assets/icon.png"
      }
    },
    "backend": "webview",
    "output": {
      "linux": "./dist/aiuse.rpm"
    }
  },
  "android": {
    "permissions": ["camera", "lan-cleartext"]
  }
}
